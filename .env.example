# Campus Carbon Bangladesh - Environment Configuration Template
# Copy to .env for local configuration

# Server Configuration
PORT=4000
NODE_ENV=development

# Optional Policy Brief LLM Adapter Configuration
# Leave blank to use the deterministic evidence-based policy brief generator
POLICY_LLM_PROVIDER=none
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Storage Configuration (Defaults to server/data/db.json)
DATABASE_PATH=server/data/db.json
